DATABASE_URL=postgresql://kce:CHANGE_ME@127.0.0.1:15432/kce_index
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=https://kadena.ws
# Enable only behind the supplied local Nginx proxy, which appends real client IPs.
TRUST_LOOPBACK_PROXY=0
CHAINWEB_URL=https://api.chainweb-community.org
# Bounded, atomic ingestion batches; the worker fetches at most two chains at once.
INDEX_CHUNK_SIZE=200
CHAINWEB_BLOCK_PAGE_SIZE=500
# Server-side read-only access to public kda-community repositories.
# Needed for reliable single-run collection; unauthenticated collection resumes at quota resets.
GITHUB_TOKEN=
GITHUB_CACHE_DIR=./data/github-cache
