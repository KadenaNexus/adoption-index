DATABASE_URL=postgresql://kce:CHANGE_ME@127.0.0.1:15432/kce_index
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=https://kadena.ws
# Enable only behind the supplied local Nginx proxy, which appends real client IPs.
TRUST_LOOPBACK_PROXY=0
CHAINWEB_URL=https://api.chainweb-community.org
# Bounded, atomic ingestion batches; the worker fetches at most two chains at once.
INDEX_CHUNK_SIZE=200
CHAINWEB_BLOCK_PAGE_SIZE=500
# Server-side read-only access to public kda-community repositories.
# Needed for reliable single-run collection; unauthenticated collection resumes at quota resets.
GITHUB_TOKEN=
GITHUB_CACHE_DIR=./data/github-cache

# --- Accounts, email and subscriptions ---
# Check these settings after every edit: npm run check-config (a mistake here switches accounts off; the index keeps running).
# Then restart with the root ecosystem file: pm2 restart ecosystem.config.cjs --update-env && pm2 save
#
# Shared secret between the website and this API (at least 32 characters). Generate: openssl rand -hex 32
# The root ecosystem.config.cjs passes it to the website (kce-web) as KCE_SITE_KEY. Unset = accounts disabled.
SITE_API_KEY=
PUBLIC_SITE_URL=https://adoption.kadena.ws
# Comma-separated emails that may open /admin.
ADMIN_EMAILS=
# Shown to subscribers on checkout and in every email, and used as the email reply-to address.
# Unset = the first ADMIN_EMAILS entry, which then becomes public.
SUPPORT_EMAIL=
# none = send nothing (the default in production when unset; sign-in then says it opens soon).
# log = write every email, sign-in links and codes included, to data/mail.log (MAIL_LOG_FILE); on the public site only
#       ADMIN_EMAILS can then sign in. For testing only: delete data/mail.log afterwards.
# resend = send through Resend (needs RESEND_API_KEY and a MAIL_FROM address on a domain verified in Resend).
MAIL_TRANSPORT=none
RESEND_API_KEY=
MAIL_FROM=Kadena Adoption Index <index@kadena.ws>
# MAIL_LOG_FILE=./data/mail.log

# Payments in USDT/USDC on BNB Smart Chain, with WalletConnect or a browser wallet.
# bsc-testnet while testing (checkout is then limited to ADMIN_EMAILS), bsc for real payments.
# Unset = checkout shows "Payments not yet open".
PAYMENT_NETWORK=
# The address that receives payments (EIP-55, as copied from the wallet).
PAYMENT_ADDRESS=
# Reown (WalletConnect) Cloud project id, 32 hex characters. Unset hides the WalletConnect button; browser wallets still work.
# In Reown Cloud, add adoption.kadena.ws to the project's allowed domains.
WALLETCONNECT_PROJECT_ID=
# 1 = a hidden 1-token, 1-day plan for admins, for one small real payment before launch.
PAYMENT_TEST_PLAN=0
# Optional overrides (defaults are three public providers per network, quorum 2 of 3, publicnode for log scans):
# BSC_RPC_URLS=
# BSC_RPC_QUORUM=2
# BSC_LOG_RPC_URLS=
# BSC_LOG_CHUNK=2000
# PAYMENT_TOKENS=USDT:0x...:18,USDC:0x...:18
# PAYMENT_SCAN_START_BLOCK=
# WORKER_INTERVAL_MS=60000
