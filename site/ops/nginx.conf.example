# Public website for adoption.kadena.ws -> Next.js (PM2 process kce-web) on localhost.
# Copy to /etc/nginx/sites-available/adoption.kadena.ws, enable it, test with `sudo nginx -t`,
# reload, then add HTTPS with `sudo certbot --nginx -d adoption.kadena.ws`.
# The site reads the backend API on 127.0.0.1 (PORT in backend/.env) itself; the API does not need a public route.
server {
    listen 80;
    listen [::]:80;
    server_name adoption.kadena.ws;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
